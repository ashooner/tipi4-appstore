{
  "schemaVersion": 2,
  "services": [
    {
      "name": "blinko",
      "image": "blinkospace/blinko:1.8.7",
      "isMain": true,
      "internalPort": 1111,
      "restart": "unless-stopped",
      "dependsOn": {
        "postgres": { "condition": "service_healthy" }
      },
      "environment": [
        { "key": "NODE_ENV", "value": "production" },
        { "key": "NEXTAUTH_URL", "value": "https://${APP_DOMAIN}" },
        { "key": "NEXT_PUBLIC_BASE_URL", "value": "https://${APP_DOMAIN}" },
        { "key": "NEXTAUTH_SECRET", "value": "${NEXTAUTH_SECRET}" },
        {
          "key": "DATABASE_URL",
          "value": "postgresql://postgres:${BLINKO_POSTGRES_PASSWORD}@postgres:5432/postgres"
        }
      ],
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/data/blinko", "containerPath": "/app/.blinko" }
      ],
      "healthCheck": {
        "test": "wget --spider -q http://127.0.0.1:1111/ || exit 1",
        "interval": "30s",
        "timeout": "10s",
        "retries": 5,
        "startPeriod": "30s"
      }
    },
    {
      "name": "postgres",
      "image": "postgres:14",
      "internalPort": 5432,
      "restart": "unless-stopped",
      "environment": [
        { "key": "POSTGRES_DB", "value": "postgres" },
        { "key": "POSTGRES_USER", "value": "postgres" },
        { "key": "POSTGRES_PASSWORD", "value": "${BLINKO_POSTGRES_PASSWORD}" }
      ],
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/data/postgres", "containerPath": "/var/lib/postgresql/data" }
      ],
      "healthCheck": {
        "test": "pg_isready -U postgres -d postgres || exit 1",
        "interval": "5s",
        "timeout": "10s",
        "retries": 5
      }
    }
  ]
}

{
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "prometheus",
      "image": "prom/prometheus:v3.9.1",
      "internalPort": 9090,
      "isMain": true,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config/prometheus.yml",
          "containerPath": "/etc/prometheus/prometheus.yml"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/metrics",
          "containerPath": "/prometheus"
        }
      ],
      "environment": {}
    },
    {
      "name": "node-exporter",
      "image": "prom/node-exporter:v1.8.1",
      "internalPort": 9100,
      "volumes": [
        {
          "hostPath": "/proc",
          "containerPath": "/host/proc",
          "readOnly": true
        },
        {
          "hostPath": "/sys",
          "containerPath": "/host/sys",
          "readOnly": true
        },
        {
          "hostPath": "/",
          "containerPath": "/rootfs",
          "readOnly": true
        }
      ],
      "command": [
        "--path.procfs=/host/proc",
        "--path.sysfs=/host/sys",
        "--path.rootfs=/rootfs"
      ]
    },
    {
      "name": "cadvisor",
      "image": "gcr.io/cadvisor/cadvisor:v0.51.0",
      "internalPort": 8080,
      "volumes": [
        {
          "hostPath": "/",
          "containerPath": "/rootfs",
          "readOnly": true
        },
        {
          "hostPath": "/var/run",
          "containerPath": "/var/run",
          "readOnly": false
        },
        {
          "hostPath": "/sys",
          "containerPath": "/sys",
          "readOnly": true
        },
        {
          "hostPath": "/var/lib/docker",
          "containerPath": "/var/lib/docker",
          "readOnly": true
        }
      ]
    },
    {
      "name": "snmp-exporter",
      "image": "prom/snmp-exporter:v0.30.1",
      "internalPort": 9116,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config/snmp.yml",
          "containerPath": "/etc/snmp_exporter/snmp.yml",
          "readOnly": true
        }
      ]
    }
  ],
  "schemaVersion": 2
}
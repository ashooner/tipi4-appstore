{
  "schemaVersion": 2,
  "services": [
    {
      "name": "session-app",
      "image": "ghcr.io/ashooner/session-app-web:0.1.1",
      "isMain": true,
      "internalPort": 3000,
      "dependsOn": {
        "session-app-pb": { "condition": "service_started" }
      },
      "environment": [
        { "key": "PRIVATE_POCKETBASE_URL", "value": "http://session-app-pb:8090" },
        { "key": "ORIGIN", "value": "https://${APP_DOMAIN}" }
      ]
    },
    {
      "name": "session-app-pb",
      "image": "ghcr.io/ashooner/session-app-pb:0.1.1",
      "internalPort": 8090,
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/data/pb_data", "containerPath": "/app/pb_data" }
      ]
    }
  ]
}
